# Copy to .env. Every lab runs without a key, on the scripted stand-in model.
# A free OpenRouter key (https://openrouter.ai/keys) makes the language model labs call a free hosted model.
OPENROUTER_API_KEY=
# Free models for the two model names a release can use; any free model with tool calling works
OPS_MODEL_STEADY=google/gemma-4-31b-it:free
OPS_MODEL_SWIFT=google/gemma-4-26b-a4b-it:free
# OPS_MODEL=scripted forces the stand-in even with a key; OPS_QUICK=1 shrinks training runs
OPS_MODEL=
OPS_QUICK=0
